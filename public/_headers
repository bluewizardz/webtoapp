# Static assets — cache aggressively (filenames are content-hashed by the
# build or stable brand owns long-lived reuse).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand-banner.webp
  Cache-Control: public, max-age=31536000, immutable

/brand-wordmark.webp
  Cache-Control: public, max-age=31536000, immutable

/og-image.jpg
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Pages should revalidate; static shell can stay fresh.
/
  Cache-Control: public, max-age=0, must-revalidate
