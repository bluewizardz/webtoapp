---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Convert Website to APK - Free Android App Wrapper Builder";
const pageDescription = "Convert website to APK with our free, no-code Android app wrapper generator. Create a high-performance WebView wrapper featuring pull-to-refresh, splash screen, and offline support.";
---

<Layout title={pageTitle} description={pageDescription} bodyClass="builder-page">
  <main class="shell">
    <div class="workspace">
      
      <!-- Left Side: Form -->
      <form class="builder-panel" id="generatorForm">
        <div class="section-title">
          <h2>App Configuration</h2>
        </div>

        <label class="field">
          <span>Website URL</span>
          <input id="siteUrl" name="siteUrl" type="url" placeholder="https://example.com" autocomplete="url" required>
        </label>

        <div class="field-grid">
          <label class="field">
            <span>App Name</span>
            <input id="appName" name="appName" type="text" placeholder="My Web App" autocomplete="organization" required>
          </label>

          <label class="field">
            <span>Version</span>
            <input id="appVersion" name="appVersion" type="text" value="1.0.0" inputmode="decimal" required>
          </label>
        </div>

        <label class="field">
          <span>App ID (Package Name)</span>
          <div class="inline-control">
            <input id="appId" name="appId" type="text" placeholder="com.example.app" spellcheck="false" required>
            <button type="button" id="resetIdButton" class="btn btn-secondary">Auto</button>
          </div>
        </label>

        <label class="field">
          <span>App Icon (Optional 512x512 PNG)</span>
          <div class="icon-upload-row">
            <input id="appIcon" type="file" accept="image/png, image/jpeg">
            <button type="button" id="removeIconButton" class="icon-remove-btn" style="display: none;" title="Remove icon">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
              Remove
            </button>
          </div>
        </label>

        <div class="icon-or-divider">
          <span class="icon-or-line"></span>
          <span class="icon-or-text">OR</span>
          <span class="icon-or-line"></span>
        </div>

        <div class="icon-fetch-container">
          <label class="icon-fetch-label">
            <input id="autoFetchIcon" type="checkbox" checked>
            <span class="toggle-switch"></span>
            <span class="icon-fetch-text">
              <strong>Auto Fetch Website Icon</strong>
              <small>Scrapes the favicon of your site automatically</small>
            </span>
          </label>
          <div class="icon-preview-wrapper">
            <img id="iconPreview" src="" alt="Icon Preview">
            <div id="iconPreviewPlaceholder" class="icon-preview-placeholder">SA</div>
            <div id="iconPreviewSpinner" class="spinner"></div>
          </div>
        </div>

        <fieldset class="features-fieldset">
          <legend>Interface Settings</legend>
          <label class="check-row">
            <input id="showSpinner" type="checkbox" checked>
            <span class="check-mark"></span>
            <span>
              <strong>Horizontal Progress Indicator</strong>
              <small>Show a thin horizontal progress line on the top edge while pages load</small>
            </span>
          </label>
          <label class="check-row">
            <input id="pullToRefresh" type="checkbox" checked>
            <span class="check-mark"></span>
            <span>
              <strong>Pull-to-Refresh</strong>
              <small>Swipe down from the top to reload the page</small>
            </span>
          </label>
          <label class="check-row">
            <input id="allowZoom" type="checkbox">
            <span class="check-mark"></span>
            <span>
              <strong>Allow Zoom</strong>
              <small>Enable pinch-to-zoom controls in the WebView</small>
            </span>
          </label>
        </fieldset>

        <fieldset class="features-fieldset">
          <legend>Visual &amp; Launch Options</legend>
          <label class="check-row">
            <input id="showSplash" type="checkbox" checked>
            <span class="check-mark"></span>
            <span>
              <strong>Splash Screen</strong>
              <small>Show a centered logo splash screen on launch</small>
            </span>
          </label>
          
          <div class="field" id="splashDurationField" style="margin-bottom: 20px;">
            <span>Splash Screen Duration (ms)</span>
            <input id="splashDuration" type="number" value="2000" min="500" max="10000" style="width: 100%;">
          </div>

          <label class="check-row">
            <input id="fullScreen" type="checkbox">
            <span class="check-mark"></span>
            <span>
              <strong>Full Screen Mode</strong>
              <small>Hide the status bar and system navigation bar</small>
            </span>
          </label>
        </fieldset>

        <fieldset class="features-fieldset">
          <legend>Advanced Settings</legend>
          <div class="field">
            <span>Custom User Agent (Optional)</span>
            <input id="customUserAgent" type="text" placeholder="e.g. MyApp/1.0 (Android)" autocomplete="off">
          </div>
        </fieldset>

        <!-- Serverless GitHub Actions Build Info -->
        <div class="info-banner">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
          </svg>
          <span>
            <strong>Build Time:</strong> APK compilation will take approximately 1.5 to 2 minutes to complete.
          </span>
        </div>

        <div class="actions">
          <button class="btn btn-primary" id="downloadButton" type="submit">
            Build & Download APK
          </button>
          <div class="build-success" id="buildSuccess" style="display: none;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span class="build-success-text">Build Successful! Your APK is downloading.</span>
          </div>
          <div class="build-retry" id="buildRetry" style="display: none;">
            <a id="retryDownloadLink" href="#" class="retry-link">Click here</a> if your download didn't start automatically.
          </div>
        </div>

        <!-- Build Progress -->
        <div class="build-progress" id="buildProgress" style="display: none;">
          <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
          </div>
          <p class="progress-text" id="progressText">Starting compilation…</p>
        </div>

        <p class="validation" id="validationMessage" aria-live="polite"></p>
      </form>

      <!-- Right Side: Preview & Meta -->
      <aside class="preview-panel" aria-label="App preview">
        
        <!-- Device Preview Frame -->
        <div class="device-preview" aria-hidden="true">
          <div class="phone">
            <div class="phone-frame">
              <div class="phone-camera"></div>
              <div class="phone-status-bar" id="phoneStatusBar">
                <span class="status-time">12:00</span>
                <span class="status-icons">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3a4.237 4.237 0 0 0-6 0zm-4-4l2 2a7.074 7.074 0 0 1 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/></svg>
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4z"/></svg>
                </span>
              </div>
              <div class="screen" id="phoneScreen">
                <div class="screen-progress" id="screenProgress"></div>
                <div class="screen-pull-refresh" id="screenPullRefresh">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                  </svg>
                </div>
                <div class="screen-splash" id="screenSplash">
                  <div class="splash-icon">
                    <span id="splashInitials">SA</span>
                  </div>
                </div>
                <span id="previewInitials">SA</span>
                <img id="previewIcon" src="" alt="App Icon" style="display: none; width: 54px; height: 54px; border-radius: 12px; object-fit: cover; box-shadow: var(--shadow-md);">
                <strong id="previewName">Site App</strong>
                <small id="previewUrl">https://example.com</small>
              </div>
              <div class="phone-nav-bar" id="phoneNavBar">
                <span class="nav-pill"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Build Summary -->
        <div class="section-title">
          <h2>Build Metadata</h2>
          <div class="status-pill" id="statusPill">Ready</div>
        </div>

        <dl class="output-meta">
          <div>
            <dt>App Name</dt>
            <dd id="outputAppName">Site App</dd>
          </div>
          <div>
            <dt>App ID</dt>
            <dd id="outputAppId">com.example.app</dd>
          </div>
          <div>
            <dt>Platform</dt>
            <dd id="artifactSummary">Android APK</dd>
          </div>
        </dl>

        <!-- Build History -->
        <div class="build-history" id="buildHistory" style="display: none;">
          <div class="section-title">
            <h2>Build History</h2>
            <button type="button" class="btn btn-secondary btn-small" id="clearHistoryBtn">Clear</button>
          </div>
          <ul class="history-list" id="historyList"></ul>
        </div>

        <div class="build-info">
          <p>Building compiles a <strong>native Android Java wrapper project</strong> containing a lightweight high-performance WebView.</p>
          <ul>
            <li><strong>No Login Required</strong> — Start building immediately without creating any account.</li>
            <li><strong>100% Free / Zero Cost</strong> — Compile unlimited Android APKs with no subscriptions or hidden fees.</li>
            <li><strong>Zero Dependencies</strong> — Compiles using standard Android APIs.</li>
            <li><strong>CI/CD Pre-configured</strong> — Workspace ZIP includes GitHub Actions.</li>
          </ul>

          <div class="warning-banner">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>
              <strong>Google Play Protect Notice:</strong> Google Play Protect might warn you during installation since the compiled APK is unrecognized/unsigned. Rest assured, the app is 100% clean and does not contain any viruses or malware.
            </span>
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script>
  import '../scripts/app.js';
</script>
