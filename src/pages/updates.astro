---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const pageTitle = "SiteToApp Updates & Changelog";
const pageDescription = "What's new in SiteToApp: Tauri engine, draft releases, redesigned previews, brand assets, SEO upgrades. Free forever.";

const updatesSchema = {
  "@graph": [
    {
      "@type": "Blog",
      "name": "SiteToApp Updates",
      "url": "https://sitetoapp.dev/updates",
      "description": pageDescription,
      "inLanguage": "en",
      "isPartOf": { "@id": "https://sitetoapp.dev/#website" },
      "publisher": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
      "blogPost": [
        {
          "@type": "BlogPosting",
          "headline": "Tauri Engine + Draft Releases",
          "url": "https://sitetoapp.dev/updates#tauri-engine",
          "mainEntityOfPage": "https://sitetoapp.dev/updates#tauri-engine",
          "datePublished": "2026-11-09",
          "dateModified": "2026-11-09",
          "inLanguage": "en",
          "author": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
          "publisher": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
          "description": "Windows builds now offer a Tauri engine (~5–10 MB vs ~70–90 MB) alongside Electron, with direct installer downloads."
        },
        {
          "@type": "BlogPosting",
          "headline": "Brand Refresh + SEO Upgrade",
          "url": "https://sitetoapp.dev/updates#brand-refresh",
          "mainEntityOfPage": "https://sitetoapp.dev/updates#brand-refresh",
          "datePublished": "2026-11-09",
          "dateModified": "2026-11-09",
          "inLanguage": "en",
          "author": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
          "publisher": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
          "description": "New brand assets (navbar banner, favicon, social card), full SEO pass: structured graphs, sitemap, guides hub, and performance improvements (WebP, fetchpriority, cache headers)."
        },
        {
          "@type": "BlogPosting",
          "headline": "Windows EXE Builder Launch",
          "url": "https://sitetoapp.dev/updates#windows-launch",
          "mainEntityOfPage": "https://sitetoapp.dev/updates#windows-launch",
          "datePublished": "2026-10-15",
          "dateModified": "2026-10-15",
          "inLanguage": "en",
          "author": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
          "publisher": { "@type": "Organization", "@id": "https://sitetoapp.dev/#org", "name": "SiteToApp" },
          "description": "Convert websites into Windows desktop apps: Electron-powered NSIS installers and portable EXEs with a live preview and downloadable source projects."
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} bodyClass="landing-page" structuredData={updatesSchema}>
  <main class="shell">
    <header class="page-hero">
      <h1>Updates and changelog</h1>
      <p class="page-lede">What's new in SiteToApp. Everything below is free forever — no tiers, no credits.</p>
      <div class="page-hero-actions">
        <a href="/guides" class="btn btn-secondary"><Icon name="book" />Browse the guides</a>
        <a href="mailto:discovereverything123@gmail.com" class="btn btn-secondary"><Icon name="support" />Ask a question</a>
      </div>
    </header>

    <div class="changelog">
      <article class="changelog-entry is-latest" id="tauri-engine">
        <div class="changelog-meta">
          <time class="changelog-date" datetime="2026-11-09">November 9, 2026</time>
          <span class="changelog-badge">Latest</span>
        </div>
        <div class="changelog-card">
          <h2>Tauri builds and draft releases</h2>
          <p>Windows EXE builds now let you pick a <strong>Tauri engine</strong> (~5–10 MB) alongside the classic Electron engine (~65–90 MB). Leaner installers, faster cold starts, and the same one-click build flow.</p>
          <ul>
            <li>Finished installers are delivered directly, keeping generated app downloads separate from the source project.</li>
            <li>Builder previews were redesigned to match the Android page.</li>
            <li>Metadata now never truncates long app names or IDs.</li>
          </ul>
        </div>
      </article>

      <article class="changelog-entry" id="brand-refresh">
        <div class="changelog-meta">
          <time class="changelog-date" datetime="2026-11-09">November 9, 2026</time>
        </div>
        <div class="changelog-card">
          <h2>Brand assets and site updates</h2>
          <p>New brand identity: navbar banner, WebP-optimized wordmark, favicon, and a 1200×630 social card. Under the hood: Organization/WebSite/FAQ/HowTo structured data on every page, a complete sitemap, security headers, immutable caching, and preloaded fonts for faster loads.</p>
          <p>New content: the <a href="/guides">guides hub</a> with step-by-step tutorials — <a href="/guides/publish-to-play-store">publishing to the Google Play Store</a>, <a href="/guides/sign-apk">signing your APK</a>, <a href="/guides/website-to-desktop-windows">building Windows desktop apps</a>, and <a href="/guides/webview-vs-electron-vs-tauri">WebView vs Electron vs Tauri</a>.</p>
        </div>
      </article>

      <article class="changelog-entry" id="windows-launch">
        <div class="changelog-meta">
          <time class="changelog-date" datetime="2026-10-15">October 15, 2026</time>
        </div>
        <div class="changelog-card">
          <h2>Windows EXE builder</h2>
          <p>Convert websites into Windows desktop apps: Electron-powered NSIS installers and portable EXEs, with engine selection, a live device preview, and downloadable source projects. Start at the <a href="/windows">Windows builder</a>.</p>
        </div>
      </article>

      <article class="changelog-entry" id="android-launch">
        <div class="changelog-meta">
          <span class="changelog-date">Earlier</span>
        </div>
        <div class="changelog-card">
          <h2>Android APK builder</h2>
          <p>The original release: free website-to-APK conversion with a native Java WebView wrapper (~30–60 KB APK), pull-to-refresh, splash screen, offline fallback, and a downloadable Android project. Start at the <a href="/android">Android builder</a>.</p>
        </div>
      </article>
    </div>

    <section class="guides-cta" aria-labelledby="updates-cta-title">
      <div>
        <h2 id="updates-cta-title">Need help?</h2>
        <p>Questions about any release? Read the FAQ for answers on builds, app size, and publishing — or email support and we'll get back to you.</p>
      </div>
      <div class="guides-cta-actions">
        <a href="/faq" class="btn btn-secondary"><Icon name="book" />Read the FAQ</a>
        <a href="mailto:discovereverything123@gmail.com" class="btn btn-primary"><Icon name="mail" />Email support</a>
      </div>
    </section>
  </main>
</Layout>
