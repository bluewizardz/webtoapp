---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "How to Publish Your Website App to the Google Play Store";
const pageDescription = "Step-by-step: build your website app, sign the APK, and submit to Google Play Console. Free, no-code.";

const breadcrumb = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sitetoapp.dev/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://sitetoapp.dev/guides" },
    { "@type": "ListItem", "position": 3, "name": "How to Publish Your Website App to the Google Play Store" }
  ]
};

const guideSchema = {
  "@graph": [{
  "@type": "HowTo",
  "name": "How to publish a website wrapper app to the Google Play Store",
  "description": "Publish the Android APK generated by SiteToApp to the Google Play Store: build, sign, create a Play Console account, upload the release, fill the store listing, and submit for review.",
  "step": [
    { "@type": "HowToStep", "name": "Build your app APK with SiteToApp", "text": "Enter your website URL on the SiteToApp Android builder, configure the app name, icon, splash screen, and features, then compile to download a signed-ready APK." },
    { "@type": "HowToStep", "name": "Install and test the APK", "text": "Transfer the APK to your Android device and install it. Verify load speed, pull-to-refresh, and offline fallback all work before submitting." },
    { "@type": "HowToStep", "name": "Create a Google Play Console developer account", "text": "Register at play.google.com/console with a one-time $25 verification fee, then complete the identity and app-access verification." },
    { "@type": "HowToStep", "name": "Create the app and upload the release", "text": "Create a new app in Play Console, upload your APK as the first production release, and set your target API and release notes." },
    { "@type": "HowToStep", "name": "Complete the store listing", "text": "Add your app name, short and full description, screenshots from the device preview, feature graphic, privacy policy URL, and content rating questionnaire." },
    { "@type": "HowToStep", "name": "Submit for review and publish", "text": "Run the pre-launch report, submit the release for Google's review (usually hours to a few days), then publish to production." }
  ]
}, breadcrumb]};
---

<Layout title={pageTitle} description={pageDescription} bodyClass="landing-page" structuredData={guideSchema}>
  <main class="shell">
    <header class="page-hero">
      <nav class="page-breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/guides">Guides</a></li>
          <li aria-current="page">Play Store Publishing</li>
        </ol>
      </nav>
      <h1>How to Publish Your Website App to Google Play</h1>
      <p class="page-lede">A comprehensive, step-by-step walkthrough taking you from a website URL to a live app listing on the Google Play Store — zero coding required.</p>
    </header>

    <div class="guide-layout">
      <!-- Sticky Navigation & Overview Sidebar -->
      <aside class="guide-sidebar" aria-label="Guide overview and navigation">
        <div class="guide-sidebar-card">
          <h2 class="guide-sidebar-title" style="margin-top: 0;">At a Glance</h2>
          <div class="guide-meta-box">
            <div class="guide-meta-item">
              <span class="guide-meta-label">Time</span>
              <span class="guide-meta-val">9 min read</span>
            </div>
            <div class="guide-meta-item">
              <span class="guide-meta-label">Level</span>
              <span class="guide-meta-val">No Code</span>
            </div>
            <div class="guide-meta-item">
              <span class="guide-meta-label">Platform</span>
              <span class="guide-meta-val">Android</span>
            </div>
            <div class="guide-meta-item">
              <span class="guide-meta-label">Cost</span>
              <span class="guide-meta-val">$25 (Google)</span>
            </div>
          </div>
        </div>

        <div class="guide-sidebar-card">
          <h2 class="guide-sidebar-title" style="margin-top: 0;">Step Navigation</h2>
          <nav class="guide-toc-nav" aria-label="Table of contents">
            <a href="#step-1" class="guide-toc-link"><span class="guide-toc-num">01</span> Build APK</a>
            <a href="#step-2" class="guide-toc-link"><span class="guide-toc-num">02</span> Device Testing</a>
            <a href="#step-3" class="guide-toc-link"><span class="guide-toc-num">03</span> Play Console</a>
            <a href="#step-4" class="guide-toc-link"><span class="guide-toc-num">04</span> Upload Release</a>
            <a href="#step-5" class="guide-toc-link"><span class="guide-toc-num">05</span> Store Listing</a>
            <a href="#step-6" class="guide-toc-link"><span class="guide-toc-num">06</span> Submit Review</a>
            <a href="#maintenance" class="guide-toc-link"><span class="guide-toc-num">07</span> Maintenance</a>
          </nav>
        </div>

        <div class="guide-sidebar-card">
          <h2 class="guide-sidebar-title" style="margin-top: 0;">Need an APK?</h2>
          <p style="font-size: 0.86rem; color: var(--accents-6); line-height: 1.5; margin: 0 0 12px;">Generate your free Android APK with native pull-to-refresh and splash screen.</p>
          <a href="/android" class="btn btn-primary btn-small" style="width: 100%; justify-content: center;">Open Android Builder</a>
        </div>
      </aside>

      <!-- Main Guide Stepper Body -->
      <div class="guide-content">
        
        <div class="callout callout-info" style="margin-top: 0;">
          <div class="callout-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <div>
            <strong>Overview:</strong> SiteToApp compiles your website into a standards-compliant native Android Java wrapper APK in minutes. Follow these 6 steps to release your app on the Google Play Store without hiring a developer.
          </div>
        </div>

        <!-- Step 1 -->
        <article class="guide-step-card" id="step-1">
          <div class="guide-step-header">
            <span class="guide-step-badge">Step 01</span>
            <h2>Build your app APK with SiteToApp</h2>
          </div>
          <p>On the <a href="/android">Android builder</a>, enter your website URL, app name, package ID, and icon. Enable the features you need — pull-to-refresh, splash screen, loading indicator, and fullscreen mode — then click <strong>Build &amp; Download APK</strong>.</p>
          <p>After a short compilation (roughly 1.5–2 minutes), download the APK directly, or grab the full workspace ZIP containing the Gradle project, assets, and GitHub Actions CI/CD workflows.</p>
          
          <div class="callout callout-tip">
            <div class="callout-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <div>
              <strong>Pro Tip:</strong> Choose an Package ID formatted as <code>com.yourbrand.appname</code>. Google Play uses this permanent identifier forever — make sure it reflects your brand domain accurately.
            </div>
          </div>
        </article>

        <!-- Step 2 -->
        <article class="guide-step-card" id="step-2">
          <div class="guide-step-header">
            <span class="guide-step-badge">Step 02</span>
            <h2>Test the APK on a physical Android device</h2>
          </div>
          <p>Before submitting anything to Google, install the compiled APK on a real phone or tablet to verify performance and usability:</p>
          <ol style="color: var(--accents-6); padding-left: 20px; line-height: 1.7; margin-bottom: 16px;">
            <li>Transfer the downloaded <code>.apk</code> file to your device via USB, Google Drive, or email.</li>
            <li>Enable <strong>Settings &rarr; Security &rarr; Install unknown apps</strong> for your file browser.</li>
            <li>Tap the APK to install and launch it.</li>
          </ol>
          <p>Check that your website renders smoothly, images load, pull-to-refresh operates intuitively, and the splash screen displays properly. If you need any tweaks, reconfigure in the builder and recompile.</p>
        </article>

        <!-- Step 3 -->
        <article class="guide-step-card" id="step-3">
          <div class="guide-step-header">
            <span class="guide-step-badge">Step 03</span>
            <h2>Create a Google Play Console developer account</h2>
          </div>
          <p>Visit <a href="https://play.google.com/console" target="_blank" rel="noopener noreferrer">play.google.com/console</a> and register a developer account. Google charges a one-time registration fee of <strong>$25 USD</strong> (SiteToApp itself is completely free).</p>
          <p>You will need:</p>
          <ul style="color: var(--accents-6); padding-left: 20px; line-height: 1.7;">
            <li>A standard Google Account with two-step verification enabled.</li>
            <li>A valid payment method to pay Google's $25 verification fee.</li>
            <li>Official identification details to complete Google's developer verification.</li>
          </ul>
        </article>

        <!-- Step 4 -->
        <article class="guide-step-card" id="step-4">
          <div class="guide-step-header">
            <span class="guide-step-badge">Step 04</span>
            <h2>Create your app &amp; upload the production release</h2>
          </div>
          <p>Once inside your Google Play Console dashboard, select <strong>Create app</strong>:</p>
          <ul style="color: var(--accents-6); padding-left: 20px; line-height: 1.7; margin-bottom: 16px;">
            <li><strong>App name:</strong> Enter your application's public title.</li>
            <li><strong>Default language:</strong> Select your target audience's primary language.</li>
            <li><strong>App type:</strong> Select <em>App</em> (not Game) and choose <em>Free</em>.</li>
          </ul>
          <p>Navigate to <strong>Release &rarr; Production &rarr; Create new release</strong>. Upload your compiled APK or signed Android App Bundle. (See our guide on <a href="/guides/sign-apk">how to sign your APK</a> if you're using a release keystore).</p>
        </article>

        <!-- Step 5 -->
        <article class="guide-step-card" id="step-5">
          <div class="guide-step-header">
            <span class="guide-step-badge">Step 05</span>
            <h2>Complete the store listing &amp; data safety declarations</h2>
          </div>
          <p>Fill out the required listing details in Google Play Console:</p>
          <ul style="color: var(--accents-6); padding-left: 20px; line-height: 1.7; margin-bottom: 16px;">
            <li><strong>Short Description:</strong> Up to 80 characters summarizing your core value.</li>
            <li><strong>Full Description:</strong> Detailed overview of features and functionality.</li>
            <li><strong>Screenshots:</strong> At least 2 phone screenshots (you can capture these directly from the live preview in our builder).</li>
            <li><strong>Feature Graphic:</strong> 1024 &times; 500 px promotional image.</li>
            <li><strong>Privacy Policy URL:</strong> Link your public privacy policy. (Reference our <a href="/privacy">Privacy Policy</a> to see what a clean, tracker-free wrapper looks like).</li>
          </ul>
          <div class="callout callout-tip">
            <div class="callout-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div>
              <strong>Data Safety Note:</strong> Because SiteToApp wrappers do not inject any telemetry SDKs, analytics tracking, or advertising identifiers, completing Google's Data Safety questionnaire is simple: state that the application itself does not collect personal data.
            </div>
          </div>
        </article>

        <!-- Step 6 -->
        <article class="guide-step-card" id="step-6">
          <div class="guide-step-header">
            <span class="guide-step-badge">Step 06</span>
            <h2>Submit for Google review and roll out</h2>
          </div>
          <p>Review the automated <strong>Pre-launch report</strong> in Play Console to confirm there are no layout or crash warnings on test devices. Click <strong>Review and roll out</strong> and submit your application for Google's review.</p>
          <p>Most clean WebView wrapper applications pass review in anywhere from 12 hours to a few days. Once approved, enable <strong>Start rollout to Production</strong> to make your app publicly accessible to billions of Android users worldwide!</p>
        </article>

        <!-- Maintenance -->
        <article class="guide-step-card" id="maintenance">
          <div class="guide-step-header">
            <span class="guide-step-badge">Info</span>
            <h2>Keeping your app up to date</h2>
          </div>
          <p>Because the wrapper loads your live website in a high-performance native WebView, content updates, blog posts, product listings, and styling changes made on your server appear in your mobile app <strong>instantly</strong> without requiring a new APK compile or store resubmission.</p>
          <p>You only need to compile and submit an update if you change your native app name, icon, splash screen duration, or package ID.</p>
        </article>

      </div>
    </div>
  </main>
</Layout>
