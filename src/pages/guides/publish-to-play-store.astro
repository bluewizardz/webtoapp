---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "How to Publish Your Website App to the Google Play Store";
const pageDescription = "Step-by-step: build your website app, sign the APK, and submit to Google Play Console. Free, no-code.";

const breadcrumb = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sitetoapp.dev/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://sitetoapp.dev/guides" },
    { "@type": "ListItem", "position": 3, "name": "How to Publish Your Website App to the Google Play Store" }
  ]
};

const guideSchema = {
  "@graph": [{
  "@type": "HowTo",
  "name": "How to publish a website wrapper app to the Google Play Store",
  "description": "Publish the Android APK generated by SiteToApp to the Google Play Store: build, sign, create a Play Console account, upload the release, fill the store listing, and submit for review.",
  "step": [
    { "@type": "HowToStep", "name": "Build your app APK with SiteToApp", "text": "Enter your website URL on the SiteToApp Android builder, configure the app name, icon, splash screen, and features, then compile to download a signed-ready APK." },
    { "@type": "HowToStep", "name": "Install and test the APK", "text": "Transfer the APK to your Android device and install it. Verify load speed, pull-to-refresh, and offline fallback all work before submitting." },
    { "@type": "HowToStep", "name": "Create a Google Play Console developer account", "text": "Register at play.google.com/console with a one-time $25 verification fee, then complete the identity and app-access verification." },
    { "@type": "HowToStep", "name": "Create the app and upload the release", "text": "Create a new app in Play Console, upload your APK as the first production release, and set your target API and release notes." },
    { "@type": "HowToStep", "name": "Complete the store listing", "text": "Add your app name, short and full description, screenshots from the device preview, feature graphic, privacy policy URL, and content rating questionnaire." },
    { "@type": "HowToStep", "name": "Submit for review and publish", "text": "Run the pre-launch report, submit the release for Google's review (usually hours to a few days), then publish to production." }
  ]
}, breadcrumb]};
---

<Layout title={pageTitle} description={pageDescription} bodyClass="landing-page" structuredData={guideSchema}>
  <main class="shell">
    <article class="content-panel">
      <h1>How to Publish Your Website App to the Google Play Store</h1>
      <p>SiteToApp compiles your website into a native Android wrapper APK in minutes. This guide walks you through the full path from a finished APK to a live Google Play Store listing — no coding required. If you haven't built your app yet, start at the <a href="/android">Android builder</a>.</p>

      <h2>Step 1 — Build your APK</h2>
      <p>On the <a href="/android">Android builder</a>, enter your website URL, app name, package ID, and icon. Enable the features you need — pull-to-refresh, splash screen, loading spinner, fullscreen mode — then click <em>Build Android APK</em>. After a short compile, download the APK directly or grab the full workspace ZIP to build and sign it yourself in Android Studio.</p>

      <h2>Step 2 — Test on a real device</h2>
      <p>Before submitting anything, install the APK on your phone: <strong>Settings → Security → enable "Install unknown apps"</strong> for your browser, then tap the APK file. Check that your site loads, the splash screen shows, and pull-to-refresh works. Fix anything in the builder and recompile — takes under a minute.</p>

      <h2>Step 3 — Create a Play Console account</h2>
      <p>Go to <a href="https://play.google.com/console" target="_blank" rel="noopener noreferrer">play.google.com/console</a> and register a developer account. It's a one-time <strong>$25 USD</strong> fee (Google charges it, not us) and requires valid payment details, an identity verification, and a contact email — typically approved within 1–2 days.</p>

      <h2>Step 4 — Create the app and upload your release</h2>
      <p>In Play Console, choose <strong>Create app → Name and default language → App (not game) → Free</strong>. Then go to <strong>Production → Create new release → Upload</strong> and add your APK. Play Console will tell you the target API level — the SiteToApp wrapper follows current Android guidelines, so this step is straightforward.</p>

      <h2>Step 5 — Fill in the store listing</h2>
      <p>You'll need: a short description (80 characters), a full description, at least 2 phone screenshots, a 1024×500 feature graphic, and the app icon. Use the device preview on the builder page to capture screenshots, and link your <a href="/privacy">privacy policy</a> — every Play Store app needs one. Complete the content rating questionnaire and answer the data safety form (a SiteToApp wrapper collects no personal data, which simplifies this).</p>

      <h2>Step 6 — Submit for review</h2>
      <p>Run Play Console's <strong>pre-launch report</strong> to catch crashes on test devices, then click <strong>Submit for review</strong>. Most wrapper apps clear review within a few hours to a few days. Once approved, hit <strong>Start rollout</strong> and your app goes live on the Play Store.</p>

      <h2>Keeping your app up to date</h2>
      <p>Because the wrapper loads your live website in a WebView, content changes on your site appear in the app instantly — no new APK needed. You only need to recompile when you change the app name, icon, or native features.</p>

      <p>Ready to build? <a href="/android"><strong>Start the free Android builder</strong></a>, or check the <a href="/faq">FAQ</a> for answers on Play Protect warnings, signing, and publishing.</p>
    </article>
  </main>
</Layout>
