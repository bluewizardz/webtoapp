---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const pageTitle = "FAQs - Website to APK Conversion & Google Play Store Publishing";
const pageDescription = "FAQ: converting websites to Android apps, Play Protect warnings, WebView capabilities, and Play Store compliance.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does SiteToApp convert a website into an Android app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SiteToApp creates a standard, native mobile app package containing a lightweight WebView container. Instead of rendering your pages inside a bulky, non-standard layout framework, it uses Google's high-performance Android WebKit components to render your site directly as a native application."
      }
    },
    {
      "@type": "Question",
      "name": "Is the compiled APK safe to upload to the Google Play Store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The generated code strictly follows Google's guidelines for Android application development. It uses standard security measures, enables mixed-content filters where necessary, and compiles cleanly with standard Gradle build workflows, making it 100% compliant for Google Play Store submissions."
      }
    },
    {
      "@type": "Question",
      "name": "Can I build release configurations locally?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. When you choose to compile your project, we package the complete Java source code, assets, and layouts into a workspace ZIP file. You can import this directly into Android Studio to compile, sign, customize layouts, and add plugins or debug locally."
      }
    },
    {
      "@type": "Question",
      "name": "Does the wrapper support offline functionality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The native wrapper enables standard DOM storage, database access, and cache configurations inside the WebView. If your website is a Progressive Web App (PWA) with active service workers, the compiled APK wrapper will support robust offline rendering automatically."
      }
    },
    {
      "@type": "Question",
      "name": "How do I customize the user agent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Inside the builder interface, open 'Advanced options' and fill in the 'Custom User Agent' field to specify a custom User Agent string. This allows your server to detect when requests originate from your custom Android wrapper and serve tailored styling or hidden components."
      }
    },
    {
      "@type": "Question",
      "name": "Why does Google Play Protect warn me during installation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Since the APK is compiled dynamically on our server and hasn't been signed with your registered developer certificate (or published to the Play Store), Google's Play Protect service will flag it as an unrecognized application. This is normal behavior for any newly generated Android app package (APK). Rest assured, your compiled app is 100% secure, clean, and does not contain any viruses or malware."
      }
    },
    {
      "@type": "Question",
      "name": "How do I publish the app to the Google Play Store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Follow our step-by-step Play Store publishing guide: it covers building and testing your APK, creating a Play Console developer account, uploading the release, completing the store listing, and submitting for review."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to publish my app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SiteToApp itself is free forever — no subscriptions, no fees, no limits on builds. The only costs are the platforms': Google Play Console charges a one-time $25 USD developer registration fee. The Microsoft Store has its own registration fee."
      }
    },
    {
      "@type": "Question",
      "name": "Is it legal to convert my website into an app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — wrapping your own website (or one you have rights to distribute) in a native app shell is legal and common. You must own the rights to the site's content and comply with the platform's developer policies (Google Play, Microsoft Store). The generated wrapper itself contains no third-party code, so there are no licensing surprises."
      }
    },
    {
      "@type": "Question",
      "name": "How big is the app I get?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Android wrapper compiles to roughly 30–60 KB because it reuses the system WebView. For Windows, pick the Tauri engine (~5–10 MB) for a lean installer or the Electron engine (~65–90 MB) for maximum Node.js compatibility."
      }
    },
    {
      "@type": "Question",
      "name": "Can I add ads or push notifications?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The generated wrapper is a clean WebView with no ad SDKs or tracking code — that's by design. If you need ads or push notifications, download the full source workspace and add your preferred SDKs in Android Studio or your Electron/Tauri project."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need Android Studio or any software installed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You can build and download an APK from your browser. Android Studio is only needed if you want to customize the generated source code locally."
      }
    },
    {
      "@type": "Question",
      "name": "How is the Windows EXE different from the Android APK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Windows builder wraps your site in a desktop shell instead of a mobile one. You choose between Electron (max compatibility) and Tauri (small, fast), then pick an NSIS installer or a portable EXE."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} bodyClass="landing-page" structuredData={faqSchema}>
  <main class="shell">
    <header class="page-hero">
      <h1>Frequently asked questions</h1>
      <p class="page-lede">Everything you need to know about converting websites to apps, Google Play submissions, Windows installers, and code ownership.</p>
    </header>

    <!-- Responsive Multi-Column FAQ Grid -->
    <div class="faq-grid" aria-label="Frequently asked questions list">
      
      <!-- Card 1 -->
      <article class="faq-card">
        <span class="faq-card-tag">Android WebView</span>
        <h2>How does SiteToApp convert a website?</h2>
        <p>SiteToApp creates a standard, native mobile app package containing a lightweight WebView container. Instead of rendering your pages inside a bulky, non-standard layout framework, it uses Google’s high-performance Android WebKit components to render your site directly as a native application.</p>
      </article>

      <!-- Card 2 -->
      <article class="faq-card">
        <span class="faq-card-tag">Play Store compliance</span>
        <h2>Is the compiled APK safe to upload to Google Play?</h2>
        <p>Yes. The generated code strictly follows Google’s guidelines for Android application development. It uses standard security measures, enables mixed-content filters where necessary, and compiles cleanly with standard Gradle build workflows, making it 100% compliant for Google Play Store submissions.</p>
      </article>

      <!-- Card 3 -->
      <article class="faq-card">
        <span class="faq-card-tag">Local toolchain</span>
        <h2>Can I build release configurations locally?</h2>
        <p>Absolutely. When you choose to compile your project, we package the complete Java source code, assets, and layouts into a workspace ZIP file. You can import this directly into Android Studio to compile, sign, customize layouts, and add plugins or debug locally.</p>
      </article>

      <!-- Card 4 -->
      <article class="faq-card">
        <span class="faq-card-tag">PWA and cache</span>
        <h2>Does the wrapper support offline functionality?</h2>
        <p>The native wrapper enables standard DOM storage, database access, and cache configurations inside the WebView. If your website is a Progressive Web App (PWA) with active service workers, the compiled APK wrapper will support robust offline rendering automatically.</p>
      </article>

      <!-- Card 5 -->
      <article class="faq-card">
        <span class="faq-card-tag">Configuration</span>
        <h2>How do I customize the user agent?</h2>
        <p>Inside the builder interface, open "Advanced options" and fill in the "Custom User Agent" field to specify a custom User Agent string. This allows your server to detect when requests originate from your custom Android wrapper and serve tailored styling or hidden components.</p>
      </article>

      <!-- Card 6 -->
      <article class="faq-card">
        <span class="faq-card-tag">Play Protect</span>
        <h2>Why does Google Play Protect warn me during installation?</h2>
        <p>Since the generated APK is compiled dynamically and is not yet signed with a registered developer certificate (or published directly on the Google Play Store), Google's Play Protect service will flag it as an unrecognized application. This is normal behavior for any newly generated Android app package (APK). Rest assured, your compiled app is 100% secure, clean, and does not contain any viruses or malware.</p>
      </article>

      <!-- Card 7 -->
      <article class="faq-card">
        <span class="faq-card-tag">Publishing</span>
        <h2>How do I publish the app to the Google Play Store?</h2>
        <p>Follow our step-by-step <a href="/guides/publish-to-play-store">Play Store publishing guide</a>: it covers building and testing your APK, creating a Play Console developer account, uploading the release, completing the store listing, and submitting for review.</p>
      </article>

      <!-- Card 8 -->
      <article class="faq-card">
        <span class="faq-card-tag">Pricing and fees</span>
        <h2>How much does it cost to publish my app?</h2>
        <p>SiteToApp itself is <strong>free forever</strong> — no subscriptions, no fees, no limits on builds. The only costs are the platforms': Google Play Console charges a one-time <strong>$25 USD</strong> developer registration. The Microsoft Store has its own registration fee. See the <a href="/guides/publish-to-play-store">publishing guide</a> for the full checklist.</p>
      </article>

      <!-- Card 9 -->
      <article class="faq-card">
        <span class="faq-card-tag">Legal rights</span>
        <h2>Is it legal to convert my website into an app?</h2>
        <p>Yes — wrapping your own website (or one you have rights to distribute) in a native app shell is legal and common. You must own the rights to the site's content and comply with the platform's developer policies (Google Play, Microsoft Store). The generated wrapper itself contains no third-party code, so there are no licensing surprises.</p>
      </article>

      <!-- Card 10 -->
      <article class="faq-card">
        <span class="faq-card-tag">File size</span>
        <h2>How big is the app I get?</h2>
        <p>The Android wrapper compiles to roughly <strong>30–60 KB</strong> because it reuses the system WebView. For Windows, pick the <strong>Tauri engine (~5–10 MB)</strong> for a lean installer or the <strong>Electron engine (~65–90 MB)</strong> for maximum Node.js compatibility — see our <a href="/guides/webview-vs-electron-vs-tauri">WebView vs Electron vs Tauri comparison</a> for the trade-offs.</p>
      </article>

      <!-- Card 11 -->
      <article class="faq-card">
        <span class="faq-card-tag">Features and ads</span>
        <h2>Can I add ads or push notifications?</h2>
        <p>The generated wrapper is a clean WebView with no ad SDKs or tracking code — that's by design. If you need ads or push notifications, download the full source workspace and add your preferred SDKs in Android Studio or your Electron/Tauri project. The wrapper gives you a standards-compliant starting point, not a locked box.</p>
      </article>

      <!-- Card 12 -->
      <article class="faq-card">
        <span class="faq-card-tag">Prerequisites</span>
        <h2>Do I need Android Studio or any software installed?</h2>
        <p>No. You can build and download an APK from your browser. Android Studio is only needed if you want to customize the generated source code locally — every download includes the full workspace ZIP.</p>
      </article>

      <!-- Card 13 -->
      <article class="faq-card">
        <span class="faq-card-tag">Windows desktop</span>
        <h2>How is the Windows EXE different from the Android APK?</h2>
        <p>The Windows builder wraps your site in a desktop shell instead of a mobile one. You choose between Electron (max compatibility) and Tauri (small, fast), then pick an NSIS installer or a portable EXE. Walk through it in our <a href="/guides/website-to-desktop-windows">website-to-Windows-desktop guide</a>.</p>
      </article>

    </div>

    <!-- Still Have Questions CTA -->
    <section class="guides-cta" aria-labelledby="faq-cta-title">
      <div>
        <h2 id="faq-cta-title">Still have questions or found a bug?</h2>
        <p>Need help with your app build or have a specific integration requirement? Contact our developer support team directly.</p>
      </div>
      <div class="guides-cta-actions">
        <a href="/guides" class="btn btn-secondary"><Icon name="book" />Explore guides</a>
        <a href="mailto:discovereverything123@gmail.com" class="btn btn-primary"><Icon name="support" />Contact support</a>
      </div>
    </section>
  </main>
</Layout>
